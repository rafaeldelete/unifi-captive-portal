{
  "entities": {
    "registrations": {
      "title": "WiFi Registrations",
      "description": "Information about users who registered for WiFi access.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The user's full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's phone number."
        },
        "macAddress": {
          "type": "string",
          "description": "The MAC address of the device."
        },
        "apMac": {
          "type": "string",
          "description": "The MAC address of the Access Point."
        },
        "ssid": {
          "type": "string",
          "description": "The SSID name."
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user registered."
        }
      },
      "required": ["fullName", "email", "phoneNumber", "macAddress"]
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": "registrations",
      "description": "Collection of WiFi registrations."
    }
  }
}
